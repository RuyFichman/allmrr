NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only. Service-role key used by the revenue sync (Project Settings → API Keys).
SUPABASE_SECRET_KEY=sb_secret_xxx

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotation: docs/security.md (REVENUE_ENCRYPTION_KEY_VERSION / REVENUE_ENCRYPTION_KEY_V<n>).
REVENUE_ENCRYPTION_KEY=

# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` to /api/cron/sync-revenue.
CRON_SECRET=

# Development only: accept rk_test_ keys. Never set this in production.
ALLOW_STRIPE_TEST_KEYS=false

# Development only. Each provider requires its own explicit test-mode opt-in.
# These do not enable providers whose read-only credential support is not yet implemented.
ALLOW_LEMONSQUEEZY_TEST_KEYS=false
ALLOW_POLAR_TEST_KEYS=false
ALLOW_PADDLE_TEST_KEYS=false
ALLOW_REVENUECAT_TEST_KEYS=false
ALLOW_GUMROAD_TEST_KEYS=false

# Development only: sk_test_ key for `npm run stripe:fixtures`. The script refuses anything else.
STRIPE_FIXTURES_SECRET_KEY=
